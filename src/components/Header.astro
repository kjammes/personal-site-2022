---
import Logo from '@/components/Logo.astro';
import { nav, site } from '@/data/site';

// With build.format 'file' the build sees paths like /blog.html, so drop the extension and any trailing slash.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand plain" href="/">
      <Logo class="mark" />
      <span>jayesh<span class="tld">.karli</span></span><span class="sr-only">, home</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a class="plain sweep" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="plain sweep" href={site.resumeUrl} target="_blank" rel="noopener">resume</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklab, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    min-height: 3.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 1.25ch;
    min-height: 2.75rem;
    color: var(--text-strong);
    font-weight: 700;
    white-space: nowrap;
    background-image: none;
  }
  .brand :global(.mark) {
    transition: transform var(--hover-t) var(--hover-ease);
  }
  .brand:hover :global(.mark) {
    transform: rotate(-8deg) scale(1.06);
  }
  .tld {
    color: var(--muted);
    transition: color var(--hover-t) var(--hover-ease);
  }
  .brand:hover .tld {
    color: var(--red);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
  }
  /* Each link is a 44px tall target for touch and is easy to see when focused. */
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    color: var(--muted);
  }
  nav a:hover {
    color: var(--text-strong);
  }
  /* Current page: red, bold, and the underline stays drawn, so it is not marked by colour alone. */
  nav a[aria-current='page'] {
    color: var(--red);
    font-weight: 700;
  }
  /* On small or short screens a sticky bar would cover too much content, and focused elements under it. */
  @media (max-width: 30rem), (max-height: 30rem) {
    .site-header {
      position: static;
    }
  }
  /* Small phones: brand on one row, the links on a second row, all still visible. */
  @media (max-width: 30rem) {
    .bar {
      padding-top: 0.25rem;
      padding-bottom: 0.25rem;
    }
    nav {
      width: 100%;
    }
    ul {
      justify-content: space-between;
      gap: 0;
      margin: 0 -0.5rem;
    }
  }
</style>
