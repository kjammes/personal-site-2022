---
/**
 * Click-to-load YouTube embed. Ships a thumbnail and a button only;
 * the iframe and YouTube's scripts load when the reader asks for them.
 */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<div class="yt" data-id={id} data-title={title}>
  <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
  <button type="button" aria-label={`Play video: ${title}`}>
    <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true"><path d="M66.5 7.7c-.8-2.9-2.5-5.4-5.4-6.2C55.8.1 34 0 34 0S12.2.1 6.9 1.6c-3 .7-4.6 3.2-5.4 6.1C.1 13 0 24 0 24s.1 11 1.5 16.3c.8 2.9 2.5 5.4 5.4 6.2C12.2 47.9 34 48 34 48s21.8-.1 27.1-1.6c3-.7 4.6-3.2 5.4-6.1C67.9 35 68 24 68 24s-.1-11-1.5-16.3z" fill="var(--accent-strong)"></path><path d="M45 24 27 14v20" fill="#fff"></path></svg>
  </button>
  <a class="watch" href={`https://www.youtube.com/watch?v=${id}`}>Watch on YouTube<span class="sr-only">: {title}</span></a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      // The button that had focus is gone; keep keyboard users in place.
      iframe.focus();
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
  }
  .yt img,
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .yt img {
    opacity: 0.75;
  }
  button {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  button:hover svg path:first-child {
    fill: var(--accent-stronger);
  }
  /* The frame clips overflow, so draw the focus ring inside the button. */
  button:focus-visible {
    outline-offset: -4px;
  }
  .watch {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    background: rgb(0 0 0 / 0.85);
    font-size: var(--fs-xs);
    color: #fff;
  }
</style>
