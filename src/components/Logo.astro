---
/**
 * The JK mark: the "J" drawn as a chevron that shares its stem with the "K",
 * on a red rounded square. Same shape as public/favicon.svg.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg class:list={['logo', className]} viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false">
  <rect x="1" y="1" width="30" height="30" rx="8" fill="var(--red)"></rect>
  <path
    d="M9 12.5 16 8v16l-7-4.5M23.5 8.5 16.5 16l7.5 7.5"
    fill="none"
    stroke="var(--bg)"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>

<style>
  .logo {
    display: block;
    flex: none;
  }
  @media (forced-colors: active) {
    rect {
      fill: CanvasText;
    }
    path {
      stroke: Canvas;
    }
  }
</style>
