---
import { site } from '@/data/site';

const links = [
  { label: 'github', name: 'GitHub', href: site.socials.github },
  { label: 'linkedin', name: 'LinkedIn', href: site.socials.linkedin },
  { label: 'youtube', name: 'YouTube', href: site.socials.youtube },
  { label: 'leetcode', name: 'LeetCode', href: site.socials.leetcode },
  { label: 'x', name: 'X (formerly Twitter)', href: site.socials.twitter },
  { label: 'rss', name: 'RSS feed', href: '/rss.xml' },
];
---

<footer class="site-footer">
  <div class="container row">
    <p class="muted">&copy; {new Date().getFullYear()} {site.name}</p>
    <nav aria-label="Social and feeds">
      <ul>
        {
          links.map(({ label, name, href }) => (
            <li>
              <a class="plain" href={href} rel={href.startsWith('http') ? 'me noopener' : undefined}>
                {label === name.toLowerCase() ? label : <><span aria-hidden="true">{label}</span><span class="sr-only">{name}</span></>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--border);
    font-size: var(--fs-sm);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25rem;
    list-style: none;
    margin: 0 -0.5rem;
    padding: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    color: var(--muted);
  }
  a:hover {
    color: var(--text-strong);
  }
</style>
